generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  name                String
  companyName         String
  passwordHash        String
  encryptionKey       String
  preferredWeightUnit String         @default("lbs")
  // White-label branding: dealer logo + theme palette + light/dark mode,
  // applied to the dealer's dashboard AND to buyer-facing deal pages.
  // Colors are all-or-nothing (themeBrand set implies all three).
  logoUrl             String?
  // Square mark for the PWA home-screen icon. SEPARATE from logoUrl on
  // purpose: a page header wants a horizontal wordmark, an app icon is
  // masked to a rounded square at ~60px. Squeezing "RUBY RECYCLING" into
  // that is an unreadable smear — they're two different assets, so the
  // dealer uploads both.
  appIconUrl          String?
  themeBrand          String?        // hex, e.g. "#2d5f8a"
  themeBrandDark      String?
  themeAccent         String?
  themeMode           String?        // "light" | "dark"; null = light
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deals               Deal[]
  contacts            Contact[]
  yardAddresses       YardAddress[]
  contactGroups       ContactGroup[]
  priceSheets         PriceSheet[]
  materialGrades      MaterialGrade[]
}

// The yard's own list of material grades, used when creating deals.
//
// PER-USER DATA, not a static list: yards add their own grades ("Insulated
// Al Wire", "Sealed Units w/ Copper"), and one yard's vocabulary isn't
// another's. Seeded lazily from DEFAULT_GRADES (lib/materials.ts) the
// first time a user's list is read, so existing accounts get it too.
//
// Deals SNAPSHOT the grade NAME into Deal.material rather than holding a
// foreign key — same rule as address snapshots. Deleting or renaming a
// grade must never rewrite the history of deals already published under
// it. That's also why there's no rename: change the name and you'd have
// two vocabularies, the deals' and the list's, silently disagreeing.
model MaterialGrade {
  id        String   @id @default(uuid())
  userId    String
  category  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Contact {
  id                String         @id @default(uuid())
  userId            String
  encryptedName     String
  encryptedEmail    String?
  encryptedPhone    String?
  encryptedWhatsApp String?
  // Encrypted like every other identity field — a buyer's employer is as
  // much a business relationship as their phone number, and storing it in
  // the clear beside encrypted columns would be an odd exception.
  encryptedCompany  String?
  tags              String         @default("")
  // Contact-level buyer portal credential: one token per buyer (channel-
  // independent) opening /portal/{token} — a hub listing every deal sent
  // to this contact, grouped Open/Won/Closed. Minted at publish (or on
  // demand from the Contacts page). Deals are shared as PER-DEAL links;
  // buyers reach the portal via the "All deals" link on any deal page,
  // so possession of any deal link reaches the whole portal in one click.
  // Rotatable and revocable from the Contacts page.
  portalToken       String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealRecipients    DealRecipient[]
  priceSheetRecipients PriceSheetRecipient[]
  groups            ContactGroup[]

  @@index([userId])
}

// Named groups of contacts (e.g. "Copper" = everyone who buys copper).
// Many-to-many: a contact can belong to multiple groups. Group names are
// plaintext labels (like yard addresses) — contact PII stays encrypted on
// the Contact rows themselves.
model ContactGroup {
  id        String    @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  Contact[]

  @@unique([userId, name])
  @@index([userId])
}

// A user's saved yard AND port locations ("Yard & Port Addresses" in the
// UI) — one shared list. Yards serve domestic pickups; ports serve export
// shipments. Deals SNAPSHOT address fields (pickup*/port* columns) rather
// than referencing these rows, so later edits/deletes never rewrite deals.
model YardAddress {
  id        String   @id @default(uuid())
  userId    String
  name      String   // label, e.g. "Main Yard", "Port of Newark"
  street    String
  city      String
  state     String
  zip       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deal {
  id            String          @id @default(uuid())
  userId        String
  title         String          // auto-generated server-side from material/loads/weight/packaging
  material      String          // ISRI code or main-category name (see lib/materials.ts)
  packaging     String          // comma-separated subset of: Bales,Boxes,Loose,Palletized
  numLoads      Int
  weightPerLoad Float
  weightUnit    String          @default("lbs")
  shippingTypes String          // comma-separated subset of: Domestic,Export
  notes         String?
  // Domestic pickup (yard) address snapshot — set only when shippingTypes
  // includes Domestic; all four together or all null. Buyers see city+state.
  pickupStreet  String?
  pickupCity    String?
  pickupState   String?
  pickupZip     String?
  // Export origin (port/dock) address snapshot — set only when shippingTypes
  // includes Export; all four together or all null. Buyers see city+state.
  portStreet    String?
  portCity      String?
  portState     String?
  portZip       String?
  askingPrice   Float?          // VESTIGIAL — editor removed; drop in a future migration
  priceUnit     String          @default("per lb") // VESTIGIAL — see askingPrice
  location      String?         // VESTIGIAL — editor removed; drop in a future migration
  status        String          @default("draft") // draft -> published -> closed (bid accepted)
  // Accepted-bid snapshot: set when a bid is accepted (status -> "closed").
  // Stored AS BID (amount + unit as entered); acceptedRecipientId points at
  // the winning DealRecipient (plain column, no FK — recipient already
  // belongs to this deal).
  acceptedPrice       Float?
  acceptedUnit        String?
  acceptedRecipientId String?
  acceptedAt          DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  expiresAt     DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images        DealImage[]
  recipients    DealRecipient[]

  @@index([userId])
  @@index([status])
}

model DealImage {
  id        String   @id @default(uuid())
  dealId    String
  url       String
  filename  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealRecipient {
  id          String    @id @default(uuid())
  dealId      String
  contactId   String?
  accessToken String    @unique
  channel     String
  sentAt      DateTime?
  viewedAt    DateTime?
  // queued  — waiting for the background sender (lib/send-queue.ts)
  // sent    — dispatched on this channel
  // failed  — attempts exhausted; the dealer shares the link by hand
  // pending — nothing to dispatch (manual channel, unconfigured, no address)
  // viewed  — buyer opened the link (overwrites the above)
  status      String    @default("pending")
  // Last failure reason + attempt count: a failed send has to be
  // diagnosable, and retries have to be bounded rather than looping.
  sendError    String?
  sendAttempts Int      @default(0)
  // Owner's read state for this conversation (inbox/unread tracking).
  // Unread = buyer messages with createdAt > ownerLastReadAt. Null =
  // never opened. Buyers have no equivalent (their page IS the thread).
  ownerLastReadAt DateTime?
  // When the owner was last emailed about unread messages in this
  // conversation (Tier 3 nudges). One nudge per unread batch: no new
  // nudge until the conversation is read again (see lib/notify.ts).
  lastNudgeAt     DateTime?
  createdAt   DateTime  @default(now())
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([dealId])
  @@index([accessToken])
}

// Chat messages. Belongs to EITHER a DealRecipient or a
// PriceSheetRecipient — exactly one FK is set. Generalized 2026-07-30 so
// price-sheet negotiations flow through the same inbox, unread counting,
// and nudge machinery as deals instead of being a parallel silo.
//
// senderType: "owner" | "buyer" | "system" (system = automated notices,
// e.g. bid accepted / bidding closed; rendered as centered notices).
// Two content types:
//   "message" — free text (content)
//   "bid"     — a USD price offer per weight unit (bidAmount + bidUnit,
//               unit ∈ WEIGHT_UNITS). Stored AS ENTERED — display-time
//               conversion happens in lib/bids.ts, never at rest.
//               content carries a formatted fallback string.
// Price-sheet offers and counters are written as ordinary "message" rows
// with a generated summary, so unread/inbox/nudges need no special case.
model Message {
  id                    String               @id @default(uuid())
  dealRecipientId       String?
  priceSheetRecipientId String?
  senderType            String
  senderName            String
  type                  String               @default("message")
  content               String
  bidAmount             Float?
  bidUnit               String?
  createdAt             DateTime             @default(now())
  dealRecipient         DealRecipient?       @relation(fields: [dealRecipientId], references: [id], onDelete: Cascade)
  priceSheetRecipient   PriceSheetRecipient? @relation(fields: [priceSheetRecipientId], references: [id], onDelete: Cascade)

  @@index([dealRecipientId])
  @@index([priceSheetRecipientId])
}

// A dated BUYING price sheet: what this yard will PAY per material. The
// second outgoing communication type alongside deals.
//
// DIRECTION IS THE MIRROR OF DEALS. On a deal the dealer SELLS and
// contacts bid up. Here the dealer BUYS: the recipient is a supplier who
// replies with what tonnage they have and what they want for it, and the
// yard counters. Read every "price" below as money the yard pays out.
//
// SNAPSHOT SEMANTICS: publishing LOCKS the sheet. This matters more now
// that responses exist — a supplier's counter is meaningless unless the
// prices they were quoting against are fixed. New prices mean a new sheet
// (duplicate the last one and edit the numbers).
model PriceSheet {
  id            String                @id @default(uuid())
  userId        String
  title         String                @default("Delivered Prices")
  // The COMEX copper basis ($/lb) this sheet was priced against. A
  // dedicated numeric field rather than prose, because it does real work:
  // it drives the staleness check that catches a sheet repriced against a
  // market that has moved. Optional — a yard quoting off something else
  // just leaves it empty.
  comexBasis    Float?
  // Free-text line under the title for anything else: "Delivered to our
  // yard", terms, a note about grading. NOT the market basis.
  headerNote    String?
  effectiveDate DateTime
  // Optional cut-off. After this the public page still SHOWS the prices
  // (a supplier needs to see what expired) but refuses new offers and
  // revisions — a locked snapshot with an unbounded lifetime is how you
  // end up honouring three-week-old copper.
  expiresAt     DateTime?
  // draft -> published (locked) -> deactivated (withdrawn)
  //
  // DEACTIVATED is a manual withdrawal, distinct from expiry: an expired
  // sheet still SHOWS its prices (a supplier needs to see what lapsed)
  // whereas a deactivated one hides them behind a "no longer valid"
  // notice. Reversible — reactivating restores the sheet as published, so
  // a misclick doesn't cost a duplicate. Existing negotiation threads stay
  // readable and writable either way; withdrawing prices must not strand a
  // conversation mid-flight.
  status        String                @default("draft")
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         PriceSheetItem[]
  recipients    PriceSheetRecipient[]

  @@index([userId])
}

// One priced line. `price` and `priceNote` are mutually exclusive: real
// sheets carry non-numeric entries like "Dirty Brass — Need Pics", which
// a bare Float column can't hold. Recovery percentages ("#1 Heavy (87%
// basis)", "Irony Alum (50%)") live inside `name` — that's how yards
// write the grade, and splitting them out would fight the domain.
model PriceSheetItem {
  id        String     @id @default(uuid())
  sheetId   String
  category  String
  name      String
  price     Float?
  priceNote String?
  unit      String     @default("lb")
  sortOrder Int        @default(0)
  sheet     PriceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId])
}

// One recipient of a sheet. PER-RECIPIENT accessToken (like DealRecipient)
// — a sheet is not broadcast material, it's an individually addressed
// offer that the supplier answers, so their reply has to be attributable.
model PriceSheetRecipient {
  id          String              @id @default(uuid())
  sheetId     String
  contactId   String?
  accessToken String              @unique
  channel     String
  // Same send-state machine as DealRecipient (queued | sent | failed |
  // pending | viewed), plus "responded" once the supplier submits.
  status      String              @default("pending")
  sentAt      DateTime?
  viewedAt    DateTime?
  sendError    String?
  sendAttempts Int                @default(0)
  // Same inbox semantics as DealRecipient: unread = supplier messages
  // newer than the marker; lastNudgeAt throttles Tier-3 email to one per
  // unread batch.
  ownerLastReadAt DateTime?
  lastNudgeAt     DateTime?
  createdAt   DateTime            @default(now())
  sheet       PriceSheet          @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  contact     Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  response    PriceSheetResponse?
  messages    Message[]

  @@index([sheetId])
  @@index([accessToken])
}

// The supplier's reply: what they have, and what they want for it. One
// per recipient — revising a reply updates this row rather than stacking
// new ones, so there's always a single current position per side.
//
// Status is the negotiation state machine:
//   submitted  supplier sent/revised their numbers; yard's move
//   countered  yard countered on one or more lines; supplier's move
//   accepted   yard accepted the supplier's current numbers (terminal)
//   declined   yard passed (terminal)
model PriceSheetResponse {
  id          String                   @id @default(uuid())
  recipientId String                   @unique
  status      String                   @default("submitted")
  buyerNote   String?
  dealerNote  String?
  // Snapshot taken at acceptance. The agreed per-line prices sit on the
  // lines, but the TOTAL is computed from weights × basis — freeze it so
  // a later change to conversion logic can't silently restate what was
  // agreed.
  agreedTotal Float?
  submittedAt DateTime                 @default(now())
  respondedAt DateTime? // yard's last action
  updatedAt   DateTime                 @updatedAt
  recipient   PriceSheetRecipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  lines       PriceSheetResponseLine[]
}

// One material the supplier actually has. `buyerPrice` null means "your
// sheet price is fine"; a value means they're asking for more.
// `dealerPrice` is the yard's counter on that line.
model PriceSheetResponseLine {
  id          String             @id @default(uuid())
  responseId  String
  itemId      String // the PriceSheetItem being answered
  weight      Float
  weightUnit  String             @default("lbs")
  buyerPrice  Float?
  dealerPrice Float?
  response    PriceSheetResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}
